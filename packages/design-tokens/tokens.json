{
  "$description": "INTERACT RECORD — jetons de design. Seule source des couleurs, typographies, espacements, rayons, ombres et animations. Proposition v0.1, à valider par la direction.",
  "color": {
    "brand": {
      "gold":       { "$value": "#F2B544", "$description": "Or de scène : couleur signature, actions principales, moments forts" },
      "gold-700":   { "$value": "#8F5C00", "$description": "Or lisible sur fond clair (texte, liens)" },
      "terracotta": { "$value": "#E8714A", "$description": "Chaleur, secondaire, dégradé de scène" },
      "terracotta-700": { "$value": "#B4441F" },
      "on-gold":    { "$value": "#1A1206", "$description": "Texte posé sur l'or (contraste 10,1:1)" }
    },
    "discipline": {
      "musique":  { "$value": "#F2B544" },
      "humour":   { "$value": "#FF7A59" },
      "danse":    { "$value": "#EC5FA8" },
      "peinture": { "$value": "#2EC4B6" },
      "autre":    { "$value": "#8B7CF6" }
    },
    "dark": {
      "bg":             { "$value": "#0B0B0D" },
      "surface-1":      { "$value": "#141417" },
      "surface-2":      { "$value": "#1C1C21" },
      "surface-3":      { "$value": "#26262D" },
      "border-subtle":  { "$value": "#2E2E36" },
      "border-strong":  { "$value": "#3D3D47" },
      "text-primary":   { "$value": "#F6F3EC", "$description": "17,7:1 sur bg" },
      "text-secondary": { "$value": "#B4B0A7", "$description": "9,1:1 sur bg" },
      "text-tertiary":  { "$value": "#8C887F", "$description": "5,6:1 sur bg, métadonnées seulement" },
      "accent":         { "$value": "{color.brand.gold}" },
      "success":        { "$value": "#3DD68C" },
      "warning":        { "$value": "#F5A524" },
      "danger":         { "$value": "#FF6B6B" },
      "info":           { "$value": "#5AA9FF" },
      "overlay":        { "$value": "rgba(11, 11, 13, 0.72)" }
    },
    "light": {
      "bg":             { "$value": "#FBF9F5" },
      "surface-1":      { "$value": "#FFFFFF" },
      "surface-2":      { "$value": "#F3F0EA" },
      "surface-3":      { "$value": "#E9E4DA" },
      "border-subtle":  { "$value": "#E4DFD5" },
      "border-strong":  { "$value": "#CFC8BB" },
      "text-primary":   { "$value": "#15130F" },
      "text-secondary": { "$value": "#57534B" },
      "text-tertiary":  { "$value": "#6F6A61" },
      "accent":         { "$value": "{color.brand.gold-700}" },
      "success":        { "$value": "#16794A" },
      "warning":        { "$value": "#9A5B00" },
      "danger":         { "$value": "#C62828" },
      "info":           { "$value": "#1F63C6" },
      "overlay":        { "$value": "rgba(21, 19, 15, 0.48)" }
    },
    "gradient": {
      "stage": { "$value": "linear-gradient(135deg, #F2B544 0%, #E8714A 100%)", "$description": "Dégradé de scène : moments forts uniquement (paiement réussi, sortie, live)" },
      "scrim": { "$value": "linear-gradient(180deg, rgba(11,11,13,0) 0%, rgba(11,11,13,0.85) 100%)", "$description": "Lisibilité du texte posé sur une image ou une vidéo" }
    }
  },
  "font": {
    "family": {
      "display": { "$value": "Unbounded", "$description": "Titres, chiffres forts. Google Fonts, licence OFL" },
      "text":    { "$value": "Inter", "$description": "Texte courant et interface. Google Fonts, licence OFL" }
    },
    "weight": { "regular": { "$value": 400 }, "medium": { "$value": 500 }, "semibold": { "$value": 600 }, "bold": { "$value": 700 } },
    "size": {
      "xs":   { "$value": 12, "lineHeight": 16 },
      "sm":   { "$value": 14, "lineHeight": 20 },
      "md":   { "$value": 16, "lineHeight": 24 },
      "lg":   { "$value": 18, "lineHeight": 26 },
      "xl":   { "$value": 20, "lineHeight": 28 },
      "2xl":  { "$value": 24, "lineHeight": 30 },
      "3xl":  { "$value": 30, "lineHeight": 36 },
      "4xl":  { "$value": 36, "lineHeight": 42 },
      "5xl":  { "$value": 48, "lineHeight": 54 },
      "6xl":  { "$value": 60, "lineHeight": 64 }
    },
    "numeric": { "$value": "tabular-nums", "$description": "Montants, compteurs, durées : chiffres à chasse fixe" }
  },
  "space": {
    "0": { "$value": 0 }, "1": { "$value": 4 }, "2": { "$value": 8 }, "3": { "$value": 12 }, "4": { "$value": 16 },
    "5": { "$value": 20 }, "6": { "$value": 24 }, "8": { "$value": 32 }, "10": { "$value": 40 }, "12": { "$value": 48 },
    "16": { "$value": 64 }, "20": { "$value": 80 }
  },
  "radius": {
    "sm":   { "$value": 6,   "$description": "Puces, badges" },
    "md":   { "$value": 10,  "$description": "Champs, boutons" },
    "lg":   { "$value": 14,  "$description": "Cartes" },
    "xl":   { "$value": 20,  "$description": "Feuilles, modales" },
    "full": { "$value": 999, "$description": "Avatars, boutons ronds, pastilles" }
  },
  "elevation": {
    "$description": "En thème sombre, la profondeur vient des surfaces (surface-1 à 3), pas des ombres.",
    "light-1": { "$value": "0 1px 2px rgba(21,19,15,0.06), 0 1px 1px rgba(21,19,15,0.04)" },
    "light-2": { "$value": "0 4px 12px rgba(21,19,15,0.08), 0 2px 4px rgba(21,19,15,0.04)" },
    "light-3": { "$value": "0 12px 32px rgba(21,19,15,0.12), 0 4px 8px rgba(21,19,15,0.06)" }
  },
  "motion": {
    "duration": {
      "instant": { "$value": 80,  "$description": "Retour de pression" },
      "fast":    { "$value": 150, "$description": "Survol, bascule, petits éléments" },
      "base":    { "$value": 220, "$description": "La plupart des transitions" },
      "slow":    { "$value": 320, "$description": "Feuilles, changements d'écran" },
      "slower":  { "$value": 480, "$description": "Grands éléments partagés (mini-lecteur → plein écran)" },
      "celebration": { "$value": 900, "$description": "Remerciement après paiement, uniquement" }
    },
    "easing": {
      "standard":   { "$value": [0.2, 0, 0, 1],   "$description": "Par défaut" },
      "enter":      { "$value": [0, 0, 0, 1],     "$description": "Éléments qui arrivent" },
      "exit":       { "$value": [0.3, 0, 1, 1],   "$description": "Éléments qui partent" },
      "emphasized": { "$value": [0.3, 0, 0, 1],   "$description": "Moments forts" }
    },
    "spring": {
      "gentle": { "stiffness": 220, "damping": 26, "$description": "Feuilles, cartes" },
      "snappy": { "stiffness": 420, "damping": 30, "$description": "Boutons, j'aime" }
    }
  },
  "size": {
    "touch-target": { "$value": 44 },
    "icon": { "sm": { "$value": 16 }, "md": { "$value": 20 }, "lg": { "$value": 24 } },
    "avatar": { "sm": { "$value": 32 }, "md": { "$value": 48 }, "lg": { "$value": 96 }, "xl": { "$value": 128 } },
    "mini-player": { "$value": 64 },
    "tab-bar": { "$value": 64 }
  },
  "breakpoint": {
    "sm": { "$value": 360 }, "md": { "$value": 768 }, "lg": { "$value": 1024 }, "xl": { "$value": 1280 }, "2xl": { "$value": 1536 }
  }
}
