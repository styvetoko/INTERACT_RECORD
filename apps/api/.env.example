# Copier en .env puis adapter
NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://interact:interact@localhost:5432/interact_dev
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_DAYS=30
# Fournisseurs : "fake" en développement, vrais fournisseurs branchés plus tard
SMS_PROVIDER=fake
PAYMENT_PROVIDER=fake
DEFAULT_COUNTRY=CM
# Stockage des fichiers : "fake" écrit sur le disque local et sert les fichiers sous /media
STORAGE_PROVIDER=fake
STORAGE_DIR=.storage
PUBLIC_MEDIA_URL=http://localhost:4000/media
# Adresse du site web public (liens de partage, QR codes)
PUBLIC_WEB_URL=http://localhost:3000
