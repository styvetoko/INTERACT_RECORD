{
  "name": "interact-record",
  "private": true,
  "description": "INTERACT RECORD : plateforme de carrière, de diffusion et de monétisation pour les artistes africains",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev:api": "pnpm --filter @interact/api dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "db:migrate": "pnpm --filter @interact/api prisma:migrate",
    "db:seed": "pnpm --filter @interact/api prisma:seed"
  }
}
